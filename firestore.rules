rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // REGLA PARA USUARIOS:
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA CATEGORÍAS DE INVENTARIO:
    match /categoriasInventario/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // REGLA PARA EVENTOS (NUEVA):
    match /eventos/{docId} {
        allow read: if request.auth != null && (
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
        );
        allow write: if request.auth != null &&
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA INVENTARIO:
    match /inventario/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA PRÉSTAMOS:
    match /prestamos/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA SUBEVENTOS:
    match /subeventos/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;

      match /inscripciones/{inscripcionId} {
        allow create: if request.resource.data.pagado == false
          && (!('userId' in request.resource.data)
            || request.resource.data.userId == null
            || (request.auth != null && request.resource.data.userId == request.auth.uid))
          && request.resource.data.nombreCompleto is string
          && request.resource.data.correo is string
          && request.resource.data.telefono is string;

        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true ||
          resource.data.userId == request.auth.uid
        );

        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
      }
    }

    // REGLA PARA TIPOS DE ACTIVIDADES:
    match /tipoSubevento/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA TORNEOS:
    match /torneos/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA LIGAS:
    match /ligas/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
