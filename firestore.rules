rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función de ayuda para comprobar si un usuario es Socio o Administrador
    function isSocioOrAdmin() {
      // La sintaxis correcta: comprobar si el documento existe Y luego comprobar los roles.
      // Esto se hace en una sola expresión booleana.
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true ||
              get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true);
    }

    // Reglas para Socios
    match /socios/{socioId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // Reglas para Usuarios
    match /usuarios/{userId} {
      allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
      allow list: if get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
      allow update: if request.auth.uid == userId;
      allow write: if get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // Reglas para Inventario
    match /inventario/{itemId} {
      allow read: if isSocioOrAdmin();
      allow write: if get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Reglas para Categorías de Inventario
    match /categoriasInventario/{categoriaId} {
        allow read: if isSocioOrAdmin();
        allow write: if get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // Reglas para Préstamos
    match /prestamos/{prestamoId} {
      allow read: if isSocioOrAdmin();
      allow create: if request.auth != null && request.resource.data.IdUsuarioResponsable == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Reglas para Eventos
    match /eventos/{eventoId} {
        allow read: if isSocioOrAdmin();
        allow write: if get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
