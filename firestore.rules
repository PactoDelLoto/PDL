rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // REGLA PARA USUARIOS:
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA CATEGORÍAS DE INVENTARIO:
    match /categoriasInventario/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // REGLA PARA EVENTOS (NUEVA):
    match /eventos/{docId} {
        allow read: if request.auth != null && (
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
        );
        allow write: if request.auth != null &&
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA INVENTARIO:
    match /inventario/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // REGLA PARA PRÉSTAMOS:
    match /prestamos/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}