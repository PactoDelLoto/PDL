rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

// Función auxiliar para verificar si el usuario es administrador
function isAdmin() {
  return request.auth != null &&
    get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
}

// Función auxiliar para verificar si el usuario es socio
function isSocio() {
  return request.auth != null &&
    get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isSocio == true;
}

// Función auxiliar para verificar si el usuario es colaborador
function isColaborador() {
  return request.auth != null &&
    get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isColaborador == true;
}

// USUARIOS
match /usuarios/{userId} {
  allow read: if request.auth != null;
  allow write: if request.auth.uid == userId || isAdmin();
}

// CATEGORÍAS DE INVENTARIO
match /categoriasInventario/{docId} {
  allow read: if isColaborador();
  allow write: if isColaborador();
}

// EVENTOS
match /eventos/{docId} {
  allow read: if true;
  allow write: if isAdmin();
}

// INVENTARIO
match /inventario/{docId} {
  allow read: if isColaborador();
  allow write: if isColaborador();
}

// PRÉSTAMOS
match /prestamos/{docId} {
  allow read: if isSocio() || isAdmin();
  allow write: if isSocio() || isAdmin();
}

// INCIDENCIAS
match /incidencias/{docId} {
  allow read: if isColaborador();
  allow create: if isColaborador();
  allow update: if isColaborador();
  allow delete: if isColaborador();
}

// SUBEVENTOS
match /subeventos/{docId} {

  allow read: if true;
  allow write: if isAdmin() || isColaborador();

  // Permitir actualizar únicamente plazasOcupadas
  allow update: if
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plazasOcupadas'])
    && resource.data.pagoPrevioEvento == false // Permite actualizar plazasOcupadas si no requiere pago previo (inscripción directa)
    && request.resource.data.plazasOcupadas == resource.data.plazasOcupadas + 1
    && (
      resource.data.plazas == 0 ||
      request.resource.data.plazasOcupadas <= resource.data.plazas
    );
}

// INSCRIPCIONES (collection group)
match /{path=**}/inscripciones/{inscripcionId} {

  // Lectura: propietario (por userId o correo), administrador o colaborador
  allow read: if request.auth != null &&
    (
      resource.data.userId == request.auth.uid ||
      resource.data.correo == request.auth.token.email ||
      isAdmin() ||
      isColaborador()
    );

  // Creación:
  // - Usuario autenticado: solo puede crearse a sí mismo
  // - Invitado: userId debe ser null o no existir
  allow create: if
    (
      request.auth != null &&
      request.resource.data.userId == request.auth.uid
    )
    ||
    (
      request.auth == null &&
      (
        !("userId" in request.resource.data) ||
        request.resource.data.userId == null
      )
    );

  // Solo administradores o colaboradores pueden modificar
  allow update: if isAdmin() || isColaborador();
  // El usuario propietario puede borrar su propia inscripción (cancelar); admin/colab pueden borrar cualquiera
  allow delete: if request.auth != null &&
    (
      resource.data.userId == request.auth.uid ||
      isAdmin() ||
      isColaborador()
    );
}

// TIPOS DE ACTIVIDADES
match /tipoSubevento/{docId} {
  allow read: if true;
  allow write: if isAdmin();
}

// TORNEOS
match /torneos/{docId} {
  allow read: if isSocio() || isAdmin();
  allow write: if isAdmin() || isColaborador();
}

// LIGAS
match /ligas/{docId} {
  allow read: if true;
  allow write: if isAdmin() || isColaborador();
}

// CONTACTOS
match /contactos/{docId} {
  allow create: if request.auth != null;
  allow read: if isAdmin();
  allow update: if isAdmin();
  allow delete: if isAdmin();
}

// SUGERENCIAS
match /sugerencias/{docId} {
  allow create: if isSocio() || isAdmin();
  allow read: if isAdmin();
  allow update: if isAdmin();
  allow delete: if isAdmin();
}

// AUDITORÍA
match /auditoria/{docId} {
  allow create: if request.auth != null;
  allow read: if isAdmin();
}

// SOLICITUDES
match /solicitudes/{docId} {
  allow create: if request.auth != null;
  allow read: if request.auth != null &&
    (resource.data.userId == request.auth.uid || isAdmin());
  allow update: if request.auth != null &&
    (resource.data.userId == request.auth.uid || isAdmin());
  allow delete: if isAdmin();
}

}
}
